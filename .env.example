# Data provider. Supabase is the default; "local" uses the in-browser store and
# is what the test suites pin themselves to.
NEXT_PUBLIC_DATA_PROVIDER=supabase

# Required when NEXT_PUBLIC_DATA_PROVIDER=supabase.
# Project Settings → API: the project URL and the publishable (anon) key.
# Both are browser-safe; row access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Named in the About dialog's footer so a screenshot says which region
# the data sits in. Project Settings → General → Region, e.g. "Singapore (ap-southeast-1)".
NEXT_PUBLIC_SUPABASE_REGION=

# --- Server-side only. Never prefixed NEXT_PUBLIC_, never sent to the browser. ---

# Postgres connection string used by `npm run db:migrate`, the seeds, snapshots,
# restore and the danger zone's wipe. Use the SESSION POOLER URI from Supabase's
# Connect panel (aws-0-<region>.pooler.supabase.com:5432, user postgres.<ref>):
# the direct host is IPv6-only. `npm run dev` and `npm run build` apply pending
# SQL to this database first, unless SKIP_DB_MIGRATE=1.
SUPABASE_DB_URL=

# Service role key. Needed at runtime by the server routes (src/app/api/**):
# adding members and their join links, public booking and its requester lookup,
# the portal, board/task/dashboard share links, and the automation runner. Also
# used by the seeds. Set it in the deployment's environment (Vercel: Secret).
SUPABASE_SERVICE_ROLE_KEY=

# The automation runner's secret. Whatever drives /api/automations/run on a
# timer (pg_cron, Vercel cron, GitHub Actions) must send the same value as a
# bearer token. With no secret set, the runner refuses scheduler calls (503).
AUTOMATION_SECRET=

# Optional: Vercel's own cron sends this instead. Ignored when AUTOMATION_SECRET is set.
# CRON_SECRET=

# The zone every "at 9am" in an automation is read in.
AUTOMATION_TIMEZONE=Australia/Melbourne

# Set to 1 to run dev/build without applying migrations.
# SKIP_DB_MIGRATE=1
