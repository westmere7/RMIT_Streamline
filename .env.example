# Data provider. Supabase is the default; "local" uses the in-browser store and
# is what the test suites pin themselves to.
NEXT_PUBLIC_DATA_PROVIDER=supabase

# Required when NEXT_PUBLIC_DATA_PROVIDER=supabase.
# Project Settings → API: the project URL and the publishable (anon) key.
# Both are browser-safe; row access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-side only. Never prefixed NEXT_PUBLIC_, never sent to the browser. ---

# Postgres connection string used by `npm run db:migrate` (and db:seed).
# Project Settings → Database → Connection string → URI, with the password filled in.
SUPABASE_DB_URL=

# Service role key, used by `npm run db:seed` to create the demo auth users
# through the Auth Admin API. Not needed for migrations.
SUPABASE_SERVICE_ROLE_KEY=
