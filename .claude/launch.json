{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "dev-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3100"
      ],
      "port": 3100,
      "env": {
        "NEXT_PUBLIC_DATA_PROVIDER": "local",
        "SKIP_DB_MIGRATE": "1"
      }
    },
    {
      "name": "dev-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3200"
      ],
      "port": 3200,
      "env": {
        "NEXT_PUBLIC_DATA_PROVIDER": "local",
        "SKIP_DB_MIGRATE": "1",
        "NEXT_DIST_DIR": ".next-preview"
      }
    },
    {
      "name": "dev-preview-live",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3200"
      ],
      "port": 3200,
      "env": {
        "SKIP_DB_MIGRATE": "1",
        "NEXT_DIST_DIR": ".next-preview"
      }
    },
    {
      "name": "live-site",
      "url": "https://rmit-streamline.vercel.app"
    }
  ]
}
